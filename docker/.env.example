# Production settings. Copy to docker/.env on the server and fill in.
# Used by docker compose (variables) and by the Laravel containers (env_file).

# --- Release -----------------------------------------------------------
# Image tag to run, e.g. 1.0.0 (or "latest").
APP_VERSION=latest
# Host port the internal router listens on (CloudPanel proxies to it).
HTTP_PORT=8080

# --- Laravel -----------------------------------------------------------
APP_NAME=Widmungen
APP_ENV=production
APP_DEBUG=false
# Generate once: docker compose run --rm app php artisan key:generate --show
APP_KEY=
APP_URL=https://admin.widmungen.rose-water.ch
APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Europe/Zurich

ADMIN_DOMAIN=admin.widmungen.rose-water.ch
STOREFRONT_URL=https://widmungen.rose-water.ch
GOTENBERG_URL=http://gotenberg:3000

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Database & Redis ---------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=widmungen
DB_USERNAME=widmungen
DB_PASSWORD=change-me-to-a-long-random-password

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# --- Mail (Mailgun SMTP) -----------------------------------------------
# EU region: smtp.eu.mailgun.org, US region: smtp.mailgun.org
MAIL_MAILER=smtp
MAIL_HOST=smtp.eu.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@mg.example.ch
MAIL_PASSWORD=
# Fallback sender; each shop can set its own in the shop settings
# (the domain must be verified in Mailgun).
MAIL_FROM_ADDRESS=widmungen@rose-water.ch
MAIL_FROM_NAME=Widmungen

# --- Storefront analytics (optional, loaded only after consent) ---------
UMAMI_SRC=
UMAMI_WEBSITE_ID=

# --- Backups --------------------------------------------------------------
BACKUP_PATH=./backups
BACKUP_SCHEDULE=30 2 * * *
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
# Optional off-site copy, e.g. "infomaniak:widmungen-backups"
# (configure the remote in docker/rclone/rclone.conf).
RCLONE_REMOTE=
